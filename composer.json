{
  "name": "gustavoqueiroz/hyperf-crud-generator",
  "description": "Extensible CRUD generator for Hyperf applications.",
  "type": "library",
  "license": "MIT",
  "keywords": ["hyperf", "crud", "generator", "scaffold", "api"],
  "require": {
    "php": ">=8.2",
    "hyperf/command": "^3.1 || ^3.2",
    "hyperf/contract": "^3.1 || ^3.2",
    "hyperf/db-connection": "^3.1 || ^3.2",
    "hyperf/http-server": "^3.1 || ^3.2",
    "hyperf/validation": "^3.1 || ^3.2",
    "hyperf/paginator": "^3.1 || ^3.2",
    "doctrine/inflector": "^2.0"
  },
  "require-dev": {
    "hyperf/database-pgsql": "^3.1 || ^3.2",
    "hyperf/database-sqlserver": "~3.2.0@RC",
    "phpunit/phpunit": "^10.5",
    "symfony/yaml": "^6.4 || ^7.0"
  },
  "suggest": {
    "hyperf/database-pgsql": "Required in the target Hyperf application for PostgreSQL connections.",
    "hyperf/database-sqlserver": "SQL Server driver for Hyperf 3.2; select a version compatible with your Hyperf installation."
  },
  "scripts": {
    "test": "phpunit",
    "test:integration": "phpunit --testsuite integration"
  },
  "autoload": {
    "psr-4": {
      "GustavoQueiroz\\HyperfCrudGenerator\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "GustavoQueiroz\\HyperfCrudGeneratorTest\\": "tests/"
    }
  },
  "extra": {
    "hyperf": {
      "config": "GustavoQueiroz\\HyperfCrudGenerator\\ConfigProvider"
    }
  },
  "config": {
    "sort-packages": true
  }
}
