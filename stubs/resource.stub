<?php

declare(strict_types=1);

namespace {{ namespace }}\Resource;

use {{ namespace }}\Model\{{ model }};

final class {{ model }}Resource
{
    public static function make({{ model }} $model): array
    {
        $data = array_intersect_key($model->toArray(), array_flip({{ visible }}));
        foreach ({{ dates }} as $field => $format) {
            if (array_key_exists($field, $data) && ($value = $model->getAttribute($field)) instanceof \DateTimeInterface) {
                $data[$field] = $value->format($format);
            }
        }
        return $data;
    }
}
