<?php

declare(strict_types=1);

namespace {{ namespace }}\Factory;

use {{ namespace }}\Model\{{ model }};

final class {{ model }}Factory
{
    /** Pass unique values and existing foreign keys through $overrides. */
    public static function definition(array $overrides = []): array
    {
        return array_replace([
{{ factory_payload }}
        ], $overrides);
    }

    public static function make(array $overrides = []): {{ model }}
    {
        return new {{ model }}(self::definition($overrides));
    }

    public static function create(array $overrides = []): {{ model }}
    {
        return {{ model }}::query()->create(self::definition($overrides))->refresh();
    }

    private static function uuid(): string
    {
        $bytes = random_bytes(16);
        $bytes[6] = chr((ord($bytes[6]) & 0x0f) | 0x40);
        $bytes[8] = chr((ord($bytes[8]) & 0x3f) | 0x80);
        $hex = bin2hex($bytes);
        return substr($hex, 0, 8) . '-' . substr($hex, 8, 4) . '-' . substr($hex, 12, 4) . '-' . substr($hex, 16, 4) . '-' . substr($hex, 20);
    }
}
