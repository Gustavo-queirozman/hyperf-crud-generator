<?php

declare(strict_types=1);

namespace {{ namespace }}\Service;

use {{ namespace }}\Contract\{{ model }}RepositoryInterface;
use {{ namespace }}\DTO\{{ model }}Data;
use {{ namespace }}\Model\{{ model }};

class {{ model }}Service
{
    public function __construct(private readonly {{ model }}RepositoryInterface $repository)
    {
    }

    public function list(int $page = 1, int $perPage = 15, string $sort = {{ primary_key }}, string $direction = 'asc', array $filters = [], ?string $search = null): array
    {
        return $this->repository->paginate($page, $perPage, $sort, $direction, $filters, $search);
    }

    public function get(int|string $id): {{ model }}
    {
        return $this->repository->findOrFail($id);
    }

    public function create({{ model }}Data $data): {{ model }}
    {
        return $this->repository->create($data->toArray());
    }

    public function update(int|string $id, {{ model }}Data $data): {{ model }}
    {
        return $this->repository->update($this->get($id), $data->toArray());
    }

    public function delete(int|string $id): void
    {
        $this->repository->delete($this->get($id));
    }
}
