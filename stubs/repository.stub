<?php

declare(strict_types=1);

namespace {{ namespace }}\Repository;

use {{ namespace }}\Contract\{{ model }}RepositoryInterface;
use {{ namespace }}\Model\{{ model }};
use {{ namespace }}\Resource\{{ model }}Resource;
use Hyperf\Database\Model\Builder;

class {{ model }}Repository implements {{ model }}RepositoryInterface
{
    public function paginate(int $page, int $perPage, string $sort, string $direction, array $filters = [], ?string $search = null): array
    {
        $allowed = {{ sortable }};
        $sort = in_array($sort, $allowed, true) ? $sort : {{ primary_key }};
        $direction = strtolower($direction) === 'desc' ? 'desc' : 'asc';
        $query = {{ model }}::query();
        foreach ($filters as $column => $value) {
            if (in_array($column, $allowed, true) && (is_scalar($value) || $value === null)) {
                $query->where($column, $value);
            }
        }
        $searchable = {{ searchable }};
        if ($search !== null && $search !== '' && $searchable !== []) {
            $query->where(function (Builder $nested) use ($search, $searchable): void {
                foreach ($searchable as $column) {
                    $nested->orWhere($column, 'like', '%' . $search . '%');
                }
            });
        }
        $query->orderBy($sort, $direction);
        foreach ({{ primary_keys }} as $key) {
            if ($sort !== $key) {
                $query->orderBy($key);
            }
        }
        $result = $query->paginate(max(1, min(100, $perPage)), ['*'], 'page', max(1, $page));
        return [
            'data' => array_map(static fn ({{ model }} $model) => {{ model }}Resource::make($model), $result->items()),
            'meta' => [
                'current_page' => $result->currentPage(),
                'per_page' => $result->perPage(),
                'total' => $result->total(),
                'last_page' => $result->lastPage(),
            ],
        ];
    }

    public function findOrFail(array|int|string $id): {{ model }}
    {
        return $this->queryByIdentifier($id)->firstOrFail();
    }

    public function create(array $data): {{ model }}
    {
{{ assign_key }}
        $model = {{ model }}::query()->create($data);
{{ repository_create_return }}
    }

    public function update({{ model }} $model, array $data): {{ model }}
    {
{{ repository_update }}
    }

    public function delete({{ model }} $model): void
    {
{{ repository_delete }}
    }

    private function queryByIdentifier(array|int|string $id): Builder
    {
        $query = {{ model }}::query();
        foreach ($this->normalizeIdentifier($id) as $column => $value) {
            $query->where($column, $value);
        }
        return $query;
    }

    private function identifier({{ model }} $model): array|int|string
    {
        $keys = {{ primary_keys }};
        if (count($keys) === 1) {
            return $model->getAttribute($keys[0]);
        }
        $id = [];
        foreach ($keys as $key) {
            $id[$key] = $model->getAttribute($key);
        }
        return $id;
    }

    private function normalizeIdentifier(array|int|string $id): array
    {
        $keys = {{ primary_keys }};
        if (! is_array($id)) {
            if (count($keys) !== 1) {
                throw new \InvalidArgumentException('Composite identifiers must be associative arrays.');
            }
            $id = [$keys[0] => $id];
        }
        if (count($id) !== count($keys) || array_diff($keys, array_keys($id)) !== []) {
            throw new \InvalidArgumentException('Identifier must contain exactly these columns: ' . implode(', ', $keys));
        }
        return array_replace(array_fill_keys($keys, null), $id);
    }

    // <crud-custom>
    // </crud-custom>
}
